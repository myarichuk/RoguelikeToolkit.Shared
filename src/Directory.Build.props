<Project>
  <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)../'))" />

  <!-- Everything under src/ is a shipped library: NuGet package + Unity (UPM) source package. -->
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <!-- Capped at Unity's documented language support so the shipped DLL avoids runtime-dependent
         features (static abstract members, required members, ...). -->
    <LangVersion>9.0</LangVersion>
    <!-- Global usings need C# 10; src files use explicit usings. -->
    <ImplicitUsings>disable</ImplicitUsings>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>

    <!-- OSS package metadata (Apache-2.0). Update the URLs for your fork. -->
    <Authors>RoguelikeToolkit Contributors</Authors>
    <Company>RoguelikeToolkit</Company>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/myarichuk/RoguelikeToolkit.Shared</PackageProjectUrl>
    <RepositoryType>git</RepositoryType>
    <RepositoryUrl>https://github.com/myarichuk/RoguelikeToolkit.Shared.git</RepositoryUrl>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <!-- Semantic versioning from git tags (e.g. event-aggregator-v1.2.3); each package sets MinVerTagPrefix. -->
    <PackageReference Include="MinVer" PrivateAssets="All" />
    <PackageReference Include="Microsoft.SourceLink.GitHub" PrivateAssets="All" />
    <!-- Public API changes must be declared in PublicAPI.Shipped.txt / PublicAPI.Unshipped.txt. -->
    <PackageReference Include="Microsoft.CodeAnalysis.PublicApiAnalyzers" PrivateAssets="All" />
  </ItemGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
    <AdditionalFiles Include="PublicAPI.Shipped.txt" />
    <AdditionalFiles Include="PublicAPI.Unshipped.txt" />
  </ItemGroup>
</Project>
