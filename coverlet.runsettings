<?xml version="1.0" encoding="utf-8" ?>
<!-- Shared coverlet settings for XPlat Code Coverage collection.
     Used by CI (.github/workflows/ci.yml) and locally; see README.md. -->
<RunSettings>
  <DataCollectionRunSettings>
    <DataCollectors>
      <DataCollector friendlyName="XPlat Code Coverage">
        <Configuration>
          <Format>cobertura</Format>
          <Exclude>[*.Tests]*</Exclude>
        </Configuration>
      </DataCollector>
    </DataCollectors>
  </DataCollectionRunSettings>
</RunSettings>
